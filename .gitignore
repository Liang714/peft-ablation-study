# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Data & artifacts (regeneratable from scripts, kept out of git; dirs tracked via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/dataset_stats.json
# The frozen MMLU forgetting-benchmark subset MUST be committed (not just
# cached) — every fine-tuning run's before/after forgetting eval (Step 7)
# needs the identical set of questions, not a freshly-resampled one.
!data/processed/mmlu_subset.jsonl
data/splits/*
!data/splits/.gitkeep
# The actual split files MUST be committed (not just cached) — Colab clones the repo fresh for
# every training run and has no way to regenerate the identical splits otherwise (real bug hit
# on the first real Colab run: training failed with FileNotFoundError since these were never
# committed, only their .gitkeep placeholder was).
!data/splits/*.jsonl
checkpoints/*
!checkpoints/.gitkeep
results/*
!results/.gitkeep
# Per-run metrics + sample predictions JSON — small, and the whole point of the project's logged record.
!results/*.json

# Experiment tracking
mlruns/
wandb/

# OS
.DS_Store
